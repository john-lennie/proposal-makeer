# PostgreSQL connection string used by the application and Drizzle commands.
# In Vercel, use Neon's pooled (-pooler) URL with TLS. Run migrations once from
# a protected job using Neon's direct URL instead.
# Copy this file to .env.local and replace the placeholders.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Better Auth application URL and a cryptographically random secret.
# Production requires an HTTPS URL and a secret of at least 32 characters.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Transactional email delivery for verification and password reset.
RESEND_API_KEY=re_your_api_key
AUTH_EMAIL_FROM=Sonder <auth@example.com>
